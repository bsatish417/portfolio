---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b) => b.data.pubDate - a.data.pubDate);
const tags = [...new Set(posts.flatMap(post => post.data.tags))].sort();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Blog" description="Articles, notes, and ideas.">
  <section class="wrap page-intro"><p class="eyebrow">THOUGHTS & NOTES</p><h1>Writing</h1><p>Articles, ideas, and things I've learned along the way.</p></section>
  <section class="wrap blog-layout">
    <div class="post-list">
      {posts.map((post) => <a class="post-row" href={`${base}/blog/${post.id}/`}><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}</time><span><strong>{post.data.title}</strong><small>{post.data.description}</small><span class="tag-list">{post.data.tags.map(tag => <span>{tag}</span>)}</span></span><span aria-hidden="true">↗</span></a>)}
      {posts.length === 0 && <p>No articles yet. Publish one in the CMS.</p>}
    </div>
    <aside id="topics" class="topic-box"><h2>Topics</h2><div class="tag-list">{tags.map(tag => <a href={`${base}/search/?q=${encodeURIComponent(tag)}`}>{tag}</a>)}</div></aside>
  </section>
</BaseLayout>

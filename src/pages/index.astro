---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b) => b.data.pubDate - a.data.pubDate).slice(0,3);
const projects = (await getCollection('projects', ({ data }) => !data.draft && data.featured)).slice(0,3);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Home">
  <section class="hero wrap">
    <p class="eyebrow">WELCOME TO MY WEBSITE</p>
    <h1>{site.tagline}</h1>
    <p class="hero-copy">{site.description}</p>
    <div class="hero-actions">
      <a class="button" href={`${base}/portfolio/`}>Explore my work</a>
      <a class="text-link" href={`${base}/about/`}>More about me ↗</a>
    </div>
  </section>
  <section class="section wrap">
    <div class="section-heading"><div><p class="eyebrow">A FEW HIGHLIGHTS</p><h2>Selected work</h2></div><a href={`${base}/portfolio/`}>View all work ↗</a></div>
    <div class="card-grid">
      {projects.map((project) => <a class="content-card" href={`${base}/portfolio/${project.id}/`}>
        {project.data.coverImage && <img class="card-image" src={`${base}${project.data.coverImage}`} alt="" />}
        <div class="card-body"><p class="card-meta">{project.data.role || 'Project'}</p><h3>{project.data.title}</h3><p>{project.data.description}</p></div>
      </a>)}
      {projects.length === 0 && <p>Add featured projects in the CMS to show them here.</p>}
    </div>
  </section>
  <section class="section wrap">
    <div class="section-heading"><div><p class="eyebrow">THOUGHTS & NOTES</p><h2>Latest writing</h2></div><a href={`${base}/blog/`}>Visit the blog ↗</a></div>
    <div class="post-list">
      {posts.map((post) => <a class="post-row" href={`${base}/blog/${post.id}/`}><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}</time><span><strong>{post.data.title}</strong><small>{post.data.description}</small></span><span aria-hidden="true">↗</span></a>)}
      {posts.length === 0 && <p>Publish your first article in the CMS.</p>}
    </div>
  </section>
</BaseLayout>

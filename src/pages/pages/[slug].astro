---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => !data.draft && !['about', 'contact'].includes(data.permalink || ''));
  return pages
    .filter((page) => !['about', 'contact'].includes(page.id))
    .map((page) => ({ params: { slug: page.id }, props: { page } }));
}
const { page } = Astro.props;
const { Content } = await render(page);
---
<BaseLayout title={page.data.title} description={page.data.description}>
  <article class="prose wrap page-content"><Content /></article>
</BaseLayout>

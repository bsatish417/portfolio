---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a,b) => Number(b.data.featured)-Number(a.data.featured));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Portfolio" description="Selected projects and experiments.">
  <section class="wrap page-intro"><p class="eyebrow">SELECTED WORK</p><h1>Portfolio</h1><p>A selection of projects, experiments, and things I've enjoyed making.</p></section>
  <section class="wrap card-grid project-grid">
    {projects.map((project) => <a class="content-card" href={`${base}/portfolio/${project.id}/`}>
      {project.data.coverImage && <img class="card-image" src={`${base}${project.data.coverImage}`} alt="" />}
      <div class="card-body"><p class="card-meta">{project.data.role || 'Project'} {project.data.date ? `· ${project.data.date.getFullYear()}` : ''}</p><h2>{project.data.title}</h2><p>{project.data.description}</p><div class="tag-list">{project.data.tags.map(tag => <span>{tag}</span>)}</div></div>
    </a>)}
  </section>
</BaseLayout>
